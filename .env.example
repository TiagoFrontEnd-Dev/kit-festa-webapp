NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Webhook/API que envia a mensagem automatica para o WhatsApp.
# Pode ser um provedor oficial, Evolution API, Z-API, n8n, Make, etc.
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
WHATSAPP_ADMIN_PHONE=

# Opcao recomendada: WhatsApp Cloud API oficial da Meta, sem intermediario.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_API_VERSION=v25.0
META_WHATSAPP_TEMPLATE_NAME=nova_reserva_admin
META_WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
META_WHATSAPP_USE_TEMPLATE=true
